# 阿里云百炼 (DashScope) API 密钥 (请替换为你自己的实际 API Key)
ALIBABACLOUD_API_KEY=your_dashscope_api_key_here

# 阿里云百炼 OpenAI 兼容模式 Base URL
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认工作模型 (Worker 模型推荐: qwen3.8-flash)
DEFAULT_MODEL=qwen3.8-flash

# 裁判模型 (Evaluator 模型: qwen3.6-flash)
EVALUATOR_MODEL=qwen3.6-flash
